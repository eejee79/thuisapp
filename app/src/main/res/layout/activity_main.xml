<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Melding nieuwe versie -->
    <TextView
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B5E20"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== Multimedia ===== -->
        <ScrollView
            android:id="@+id/mediaPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="Multimedia"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/mediaList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/mediaStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== Dashboard ===== -->
        <ScrollView
            android:id="@+id/dashPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="Dashboard"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/dashList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/dashStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== Tab 1: Home Assistant ===== -->
        <ScrollView
            android:id="@+id/haPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="Lampen"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/groupList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== Tab 2: Proxmox ===== -->
        <ScrollView
            android:id="@+id/pvePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="Proxmox"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/vmList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/pveStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== Tab 3: Fritzbox ===== -->
        <ScrollView
            android:id="@+id/fritzPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="Fritzbox"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/fritzList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/fritzStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/settingsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="10dp"
            android:text="⚙"
            android:textColor="#B0B0B0"
            android:textSize="24sp" />

        <!-- Alles uit: lampen, tv, receiver, mediaspeler -->
        <ImageButton
            android:id="@+id/powerButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="56dp"
            android:contentDescription="Alles uit"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:src="@drawable/ic_power" />

        <!-- ===== Instellingen ===== -->
        <ScrollView
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/settingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Instellingen"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Hoofdmenu: API's en Updates -->
                <LinearLayout
                    android:id="@+id/settingsMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/menuApi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="API's"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/menuUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="Updates"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- Submenu API's: één item per API -->
                <LinearLayout
                    android:id="@+id/apiMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/menuHa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="Home Assistant"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/menuPve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="Proxmox"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/menuFritz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="Fritzbox"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/menuSpotify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="Spotify"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/menuMusic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="Muziek (netwerkmap)"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/menuKodi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#1E1E1E"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:text="Kodi"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                </LinearLayout>

                <!-- Onderdeel: Home Assistant -->
                <LinearLayout
                    android:id="@+id/haSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Extern adres (Nabu Casa)"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/urlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://xxxx.ui.nabu.casa"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Lokaal adres (thuis, eerst geprobeerd)"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/localUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="http://192.168.1.10:8123"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Long-lived access token"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/tokenInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <Button
                        android:id="@+id/saveHa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Opslaan" />
                </LinearLayout>

                <!-- Onderdeel: Proxmox -->
                <LinearLayout
                    android:id="@+id/pveSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="URL"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/pveUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://192.168.1.11:8006"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Token ID"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/pveTokenIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="root@pam!App"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Secret"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/pveSecretInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <Button
                        android:id="@+id/savePve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Opslaan" />
                </LinearLayout>

                <!-- Onderdeel: Fritzbox -->
                <LinearLayout
                    android:id="@+id/fritzSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="URL (TR-064)"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/fritzUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://fritzbox.example.nl/tr064"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Gebruiker"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/fritzUserInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Wachtwoord"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/fritzPassInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <Button
                        android:id="@+id/saveFritz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Opslaan" />
                </LinearLayout>

                <!-- Onderdeel: Spotify -->
                <LinearLayout
                    android:id="@+id/spotifySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Client ID (uit je app op developer.spotify.com)"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/spClientIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Zet bij je Spotify-app onder Redirect URIs ook: thuisbasis://spotify-callback"
                        android:textColor="#888888"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/spLoginButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Opslaan en inloggen bij Spotify" />

                    <Button
                        android:id="@+id/spLogoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Uitloggen" />

                    <TextView
                        android:id="@+id/spStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="#B0B0B0"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Onderdeel: Muziek (SMB) -->
                <LinearLayout
                    android:id="@+id/musicSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Netwerkmap"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/smbPathInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="\\\\192.168.1.10\\muziek"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Gebruiker"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/smbUserInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Wachtwoord"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/smbPassInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <Button
                        android:id="@+id/saveMusic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Opslaan en testen" />

                    <TextView
                        android:id="@+id/smbStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="#B0B0B0"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Onderdeel: Kodi -->
                <LinearLayout
                    android:id="@+id/kodiSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zet in Kodi aan: Instellingen → Diensten → Bediening → HTTP toestaan + bediening door andere systemen."
                        android:textColor="#888888"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Adres van de box"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/kodiHostInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="192.168.50.140"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Poort"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/kodiPortInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="8080"
                        android:inputType="number"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Gebruiker"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/kodiUserInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="kodi"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Wachtwoord"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/kodiPassInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Ondertitels zoeken in de app (OpenSubtitles.com)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gratis account op opensubtitles.com, en een API-sleutel via opensubtitles.com/consumers (nieuwe consumer aanmaken)."
                        android:textColor="#888888"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="API-sleutel"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/osKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Gebruikersnaam"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/osUserInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Wachtwoord"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/osPassInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Talen (op volgorde)"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/osLangInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="nl,en"
                        android:inputType="text"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />


                    <Button
                        android:id="@+id/saveKodi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Opslaan en testen" />

                    <TextView
                        android:id="@+id/kodiStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="#B0B0B0"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Onderdeel: Updates -->
                <LinearLayout
                    android:id="@+id/updateSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/updateVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="GitHub-token (alleen lezen, repo thuisapp)"
                        android:textColor="#B0B0B0" />

                    <EditText
                        android:id="@+id/ghTokenInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="github_pat_…"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666" />

                    <Switch
                        android:id="@+id/autoUpdateSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Automatisch controleren (elke minuut in de app, en elk kwartier op de achtergrond met een melding)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/updateSaveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Opslaan" />

                    <Button
                        android:id="@+id/checkUpdateButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Controleer nu" />

                    <TextView
                        android:id="@+id/updateStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="#B0B0B0"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

